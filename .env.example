# Copy this file to .env and fill in real values. .env is gitignored.
# These are only needed for the OPTIONAL MQTT collector (edge/collector.py).
# The default serial path (edge/serial_collector.py, used by
# start_smart_agri.bat) needs no credentials at all.

MQTT_BROKER=your-broker-id.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USERNAME=your-username
MQTT_PASSWORD=your-password
MQTT_TOPIC=smartagri/data

# Site coordinates used for the weather forecast lookup
SITE_LAT=23.2547
SITE_LON=77.4029
